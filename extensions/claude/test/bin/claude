#!/usr/bin/env node
/*
 * Fake `claude` for the tests: streams Claude Code's `--output-format stream-json
 * --include-partial-messages` events for one model call, then the result. $FAKE_PAUSE waits that many ms between them.
 * Every call is appended to $FAKE_LOG as one JSON line {pid, argv, stdin, cwd}. The answer is
 * $FAKE_ANSWER (default: the last prompt line). A prompt containing $FAKE_FAIL fails, $FAKE_HANG
 * never returns, $FAKE_SLOW answers after 300 ms. $FAKE_EXIT is the exit code after an answer.
 * FAKE_EVENT_FILE (or FAKE_EVENTS) adds native JSONL, optionally split into byte chunks.
 * FAKE_EVENT_GATE_AFTER pauses after that line until FAKE_EVENT_GATE exists, for live assertions.
 */
import { appendFileSync, existsSync, readFileSync } from 'node:fs';

const argv = process.argv.slice(2);
if (argv.includes('--help')) {
  if (process.env.FAKE_HELP_EXIT) process.exit(1);
  console.log(process.env.FAKE_HELP ?? '--tools <tools...>\n--strict-mcp-config\n--mcp-config <configs...>\n--disable-slash-commands\n--permission-mode (choices: "default", "bypassPermissions")');
  process.exit(0);
}
const stdin = readFileSync(0, 'utf8');
const { FAKE_LOG, FAKE_ANSWER, FAKE_FAIL, FAKE_HANG, FAKE_SLOW, FAKE_EXIT, FAKE_PAUSE } = process.env;
if (FAKE_LOG) appendFileSync(FAKE_LOG, JSON.stringify({ pid: process.pid, argv, stdin, cwd: process.cwd() }) + '\n');
const matches = (needle) => needle && stdin.includes(needle);

if (matches(FAKE_HANG)) setInterval(() => {}, 1000);
else {
  if (matches(FAKE_SLOW)) await new Promise((resolve) => setTimeout(resolve, 300));
  const failed = matches(FAKE_FAIL);
  // Over a --max-budget-usd below its cost of $0.01, Claude Code ends as error_max_budget_usd.
  const budget = argv.includes('--max-budget-usd') && Number(argv[argv.indexOf('--max-budget-usd') + 1]) < 0.01;
  const answer = FAKE_ANSWER ?? `claude: ${stdin.trim().split('\n').pop()}`;
  const schema = argv.includes('--json-schema');
  const usage = { input_tokens: 10, cache_creation_input_tokens: 5, cache_read_input_tokens: 20 };
  const stream = (event) => console.log(JSON.stringify({ type: 'stream_event', event }));
  stream({ type: 'message_start', message: { id: 'msg_1', usage: { ...usage, output_tokens: 1 } } });
  if (process.env.FAKE_BLOCK) stream({ type: 'content_block_start', content_block: JSON.parse(process.env.FAKE_BLOCK) });
  const events = process.env.FAKE_EVENT_FILE ? readFileSync(process.env.FAKE_EVENT_FILE, 'utf8') : process.env.FAKE_EVENTS || '';
  let count = 0;
  for (const line of events.split('\n').filter(Boolean)) {
    const bytes = Buffer.from(line + '\n');
    const size = Number(process.env.FAKE_EVENT_CHUNK_SIZE) || bytes.length;
    for (let i = 0; i < bytes.length; i += size) process.stdout.write(bytes.subarray(i, i + size));
    if (++count === Number(process.env.FAKE_EVENT_GATE_AFTER)) {
      while (!existsSync(process.env.FAKE_EVENT_GATE)) await new Promise((resolve) => setTimeout(resolve, 10));
    }
  }
  if (FAKE_PAUSE) await new Promise((resolve) => setTimeout(resolve, Number(FAKE_PAUSE)));
  stream({ type: 'message_delta', usage: { ...usage, output_tokens: 7 } });
  console.log(
    JSON.stringify({
      type: 'result',
      subtype: budget ? 'error_max_budget_usd' : failed ? 'error_during_execution' : 'success',
      is_error: failed || budget,
      result: budget ? null : failed ? 'claude boom' : schema ? '' : answer,
      ...(schema && !failed && { structured_output: JSON.parse(answer) }),
      total_cost_usd: 0.01,
      modelUsage: { 'claude-opus-5-5': { outputTokens: 7 }, 'claude-haiku-4-5': { outputTokens: 1 } },
      usage: budget ? {} : { input_tokens: 10, cache_creation_input_tokens: 5, cache_read_input_tokens: 20, output_tokens: 7 },
    }),
  );
  process.exitCode = failed || budget ? 1 : Number(FAKE_EXIT || 0);
}

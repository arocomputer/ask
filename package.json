{
  "name": "@arocomputer/ask",
  "version": "0.4.0-dev",
  "description": "Hand tasks to subagents",
  "license": "MIT",
  "type": "module",
  "repository": "github:arocomputer/ask",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "ask": "dist/src/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src",
    "dist/native",
    "dist/package.json"
  ],
  "scripts": {
    "check": "tsc",
    "test": "node --test 'test/**/*.test.ts' && bun test ./test/",
    "build": "rm -rf dist && tsc --noEmit false --declaration --rewriteRelativeImportExtensions --outDir dist --rootDir . && mkdir -p dist/native && cp native/sandybox.c dist/native/ && (cp -R native/build dist/native/ 2>/dev/null || true)",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}

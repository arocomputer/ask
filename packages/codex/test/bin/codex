#!/usr/bin/env node
/*
 * Fake `codex` for the tests: streams Codex's `--json` events on stdout and writes the answer to
 * the `-o` file. Every call is appended to $FAKE_LOG as one JSON line {pid, argv, stdin, cwd,
 * schema}, schema being the --output-schema file's content. The answer is $FAKE_ANSWER (default:
 * the last prompt line). A prompt containing $FAKE_FAIL fails, $FAKE_HANG never returns,
 * $FAKE_SLOW answers after 300 ms; $FAKE_PAUSE waits that many ms after reporting usage. $FAKE_EXIT is the exit code after an answer; $FAKE_IGNORE_TERM
 * makes it ignore SIGTERM. $FAKE_EVENTS streams extra JSONL before usage, waiting
 * $FAKE_EVENT_PAUSE ms after each line.
 * FAKE_EVENT_FILE supplies those events from a fixture; FAKE_EVENT_CHUNK_SIZE splits their bytes.
 * FAKE_EVENT_GATE_AFTER pauses after that line until FAKE_EVENT_GATE exists, for live assertions.
 */
import { appendFileSync, existsSync, readFileSync, writeFileSync } from 'node:fs';

const argv = process.argv.slice(2);
if (argv[0] === 'app-server') {
  let buffer = '';
  for await (const chunk of process.stdin) {
    buffer += chunk;
    for (let end; (end = buffer.indexOf('\n')) !== -1;) {
      const line = buffer.slice(0, end);
      buffer = buffer.slice(end + 1);
      const message = JSON.parse(line);
      if (message.method === 'initialize') {
        console.log(JSON.stringify({ id: message.id, result: {} }));
      } else if (message.method === 'thread/resume') {
        console.log(JSON.stringify({ id: message.id, result: { thread: { id: message.params.threadId } } }));
      } else if (message.method === 'thread/name/set') {
        if (process.env.FAKE_TITLE_LOG) appendFileSync(process.env.FAKE_TITLE_LOG, JSON.stringify(message.params));
        console.log(JSON.stringify({ id: message.id, result: {} }));
      }
    }
  }
  process.exit(0);
}
const stdin = readFileSync(0, 'utf8');
const { FAKE_LOG, FAKE_ANSWER, FAKE_FAIL, FAKE_HANG, FAKE_SLOW, FAKE_EXIT, FAKE_IGNORE_TERM } = process.env;
if (FAKE_IGNORE_TERM) process.on('SIGTERM', () => {});
const after = (flag) => argv[argv.indexOf(flag) + 1];
const schemaFile = argv.includes('--output-schema') ? after('--output-schema') : null;
if (FAKE_LOG) {
  const schema = schemaFile ? JSON.parse(readFileSync(schemaFile, 'utf8')) : null;
  appendFileSync(FAKE_LOG, JSON.stringify({ pid: process.pid, argv, stdin, cwd: process.cwd(), schema }) + '\n');
}
const matches = (needle) => needle && stdin.includes(needle);

if (matches(FAKE_HANG)) setInterval(() => {}, 1000);
else {
  if (matches(FAKE_SLOW)) await new Promise((resolve) => setTimeout(resolve, 300));
  console.log(JSON.stringify({ type: 'thread.started', thread_id: 'fake' }));
  if (matches(FAKE_FAIL)) {
    console.log(JSON.stringify({ type: 'error', message: 'codex boom' }));
    process.exitCode = 1;
  } else {
    writeFileSync(after('-o'), FAKE_ANSWER ?? `codex: ${stdin.trim().split('\n').pop()}`);
    const events = process.env.FAKE_EVENT_FILE ? readFileSync(process.env.FAKE_EVENT_FILE, 'utf8') : process.env.FAKE_EVENTS || '';
    let count = 0;
    for (const line of events.split('\n').filter(Boolean)) {
      const bytes = Buffer.from(line + '\n');
      const size = Number(process.env.FAKE_EVENT_CHUNK_SIZE) || bytes.length;
      for (let i = 0; i < bytes.length; i += size) process.stdout.write(bytes.subarray(i, i + size));
      if (++count === Number(process.env.FAKE_EVENT_GATE_AFTER)) {
        while (!existsSync(process.env.FAKE_EVENT_GATE)) await new Promise((resolve) => setTimeout(resolve, 10));
      }
      if (process.env.FAKE_EVENT_PAUSE) await new Promise((resolve) => setTimeout(resolve, Number(process.env.FAKE_EVENT_PAUSE)));
    }
    const usage = { input_tokens: 100, cached_input_tokens: 40, output_tokens: 8, reasoning_output_tokens: 2 };
    console.log(JSON.stringify({ type: 'turn.completed', usage }));
    if (process.env.FAKE_PAUSE) await new Promise((resolve) => setTimeout(resolve, Number(process.env.FAKE_PAUSE)));
    process.exitCode = Number(FAKE_EXIT || 0);
  }
}

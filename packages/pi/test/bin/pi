#!/usr/bin/env node
/* Fake Pi: recorded argv/stdin and upstream-shaped JSON events, without models or network. */
const { appendFileSync, existsSync, readFileSync } = require('node:fs');
const argv = process.argv.slice(2);
if (argv.includes('--help')) {
  if (process.env.FAKE_HELP_FAIL) process.exit(2);
  console.log('--extension --no-extensions --no-skills --no-prompt-templates --no-themes' + (process.env.FAKE_OLD_PI ? '' : ' --no-mcp'));
  process.exit(0);
}
const stdin = readFileSync(0, 'utf8');
appendFileSync(process.env.FAKE_LOG, JSON.stringify({ argv, stdin, cwd: process.cwd(), offline: process.env.PI_OFFLINE,
  auth: {
    file: existsSync(require('node:path').join(process.env.PI_CODING_AGENT_DIR || require('node:path').join(process.env.HOME, '.pi', 'agent'), 'auth.json')),
    models: existsSync(require('node:path').join(process.env.PI_CODING_AGENT_DIR || require('node:path').join(process.env.HOME, '.pi', 'agent'), 'models.json')),
    openai: !!process.env.OPENAI_API_KEY, awsSession: !!process.env.AWS_SESSION_TOKEN,
    copilot: !!process.env.COPILOT_GITHUB_TOKEN, adc: !!process.env.GOOGLE_APPLICATION_CREDENTIALS,
    unrelated: !!process.env.UNRELATED_SECRET, preload: !!process.env.NODE_OPTIONS,
  } }) + '\n');
const emit = (event) => process.stdout.write(JSON.stringify(event) + (process.env.FAKE_NO_NEWLINE && event.type === 'message_end' && event.message.model ? '' : '\n'));
const usage = { input: 20, output: 5, cacheRead: 3, cacheWrite: 2, cost: { total: 0.01 } };
if (!process.env.FAKE_EVENTS) emit({ type: 'session', id: 'pi-session' });
// Replay native JSONL in wire order; an optional barrier proves delivery before CLI exit.
if (process.env.FAKE_EVENTS) {
  const bytes = readFileSync(process.env.FAKE_EVENTS);
  let barrier = -1;
  for (let i = 0; i < Number(process.env.FAKE_PAUSE_AFTER || 0); i++) barrier = bytes.indexOf(10, barrier + 1);
  const write = (data) => {
    for (let i = 0; i < data.length; i += 37) process.stdout.write(data.subarray(i, i + 37));
  };
  if (barrier >= 0) {
    write(bytes.subarray(0, barrier + 1));
    setTimeout(() => write(bytes.subarray(barrier + 1)), Number(process.env.FAKE_PAUSE || 1200));
  } else write(bytes);
  // Do not mix default events into the native fixture stream.
} else if (!process.env.FAKE_EMPTY) {
  emit({ type: 'message_end', message: { role: 'user', content: [{ type: 'text', text: 'user' }] } });
  if (!process.env.FAKE_NO_USAGE) emit({ type: 'message_update', usage });
  emit({ type: 'message_end', message: { role: 'assistant', content: [{ type: 'text', text: 'intermediate' }, { type: 'toolCall', name: 'read' }], ...(process.env.FAKE_NO_USAGE ? {} : { usage }), stopReason: 'toolUse' } });
  if (!process.env.FAKE_NO_USAGE) emit({ type: 'message_update', usage });
  if (process.env.FAKE_COMPACTION) emit({ type: 'compaction_end', result: { usage } });
  if (process.env.FAKE_PAUSE) awaitPause();
  else answer();
}
/* Delay the final message so tests can inspect the live report. */
function awaitPause() { setTimeout(answer, Number(process.env.FAKE_PAUSE)); }
/* Finish with text, an error, or an incomplete tool turn. */
function answer() {
  emit({ type: 'message_end', message: { role: 'assistant', model: 'exact-model', content: [{ type: 'thinking', thinking: 'private reasoning' }, { type: 'text', text: 'answer' }, { type: 'text', text: ' parts' }], ...(process.env.FAKE_NO_USAGE ? {} : { usage }), stopReason: process.env.FAKE_REASON || 'stop', errorMessage: process.env.FAKE_REASON === 'error' ? 'provider failed' : undefined } });
  process.exitCode = Number(process.env.FAKE_EXIT || 0);
}
